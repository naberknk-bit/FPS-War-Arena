{
  "version": 2,
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/3d-game run build",
  "outputDirectory": "Desktop/FPS-War-Arena-main/artifacts/3d-game/dist/public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}
